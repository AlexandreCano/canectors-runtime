{
  "name": "auth-oauth2-token-shortlived",
  "priority": 1,
  "request": {
    "method": "POST",
    "urlPath": "/auth/oauth2/token-shortlived",
    "bodyPatterns": [ { "contains": "grant_type=client_credentials" } ]
  },
  "response": {
    "status": 200,
    "headers": { "Content-Type": "application/json" },
    "jsonBody": { "access_token": "lab-oauth2-access-token", "token_type": "Bearer", "expires_in": 1 }
  }
}
